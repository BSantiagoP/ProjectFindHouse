# Copy to backend/.env and fill in. Never commit real values.

# Bearer token for local API access (Milestone 1). Supabase Auth replaces this later.
API_TOKEN=change-me-to-a-long-random-string

# Listing provider: "hasdata" (live, uses credits) or "fixture" (local sample data, free)
PROVIDER=fixture
HASDATA_API_KEY=

# Hard cap on provider requests per search run (each HasData request = 10 credits)
MAX_REQUESTS_PER_RUN=15
# Max result pages per town search
MAX_PAGES_PER_TOWN=1
# Fetch property details (description) for candidates that pass the cheap pre-filters
FETCH_DETAILS=true
