# Copy to backend/.env and fill in. Never commit real values.

# Bearer token for local API access (Milestone 1). Supabase Auth replaces this later.
API_TOKEN=change-me-to-a-long-random-string

# Listing provider: "hasdata" (live, uses credits) or "fixture" (local sample data, free)
PROVIDER=fixture
HASDATA_API_KEY=

# Hard cap on provider requests per search run (each HasData request = 10 credits)
MAX_REQUESTS_PER_RUN=25
# Max result pages per town search
MAX_PAGES_PER_TOWN=1
# Fetch property details (description) for candidates that pass the cheap pre-filters
FETCH_DETAILS=true

# Supabase (Milestone 2). Leave empty to use in-memory storage.
# Service-role/secret key is server-side only: never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Milestone 3: analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
RENTCAST_API_KEY=
# Hard monthly cap on RentCast requests (free plan = 50; overage $0.20 each)
RENTCAST_MONTHLY_CAP=45
# Photo analysis (OpenAI vision): triage all photos low-res, inspect up to 10 at high detail
PHOTO_ANALYSIS_ENABLED=true
