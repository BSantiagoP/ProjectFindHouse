<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.homescout.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/bryampiedra/Desktop/FindingAHouse/backend/scripts/run_daily.sh</string>
  </array>
  <!-- Every day at 08:00 local time. If the Mac is asleep, launchd runs it on wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/bryampiedra/Library/Logs/HomeScout/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bryampiedra/Library/Logs/HomeScout/launchd.err.log</string>
</dict>
</plist>
