<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.homescout.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/bryampiedra/Projects/FindingAHouse/backend/scripts/run_daily.sh</string>
  </array>
  <!-- Check hourly (and at login). The job itself decides if a run is due:
       every RUN_EVERY_DAYS days, at/after RUN_HOUR Eastern. A closed Mac catches up on wake. -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/bryampiedra/Library/Logs/HomeScout/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bryampiedra/Library/Logs/HomeScout/launchd.err.log</string>
</dict>
</plist>
