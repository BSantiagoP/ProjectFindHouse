# Copy to frontend/.env.local (never commit). Both values are in Supabase -> Project Settings -> API.
# The anon/publishable key is safe in the browser ONLY because every table has row-level security.
# Never put the service-role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
